# Copier en .env pour le développement local.
# En production, ces variables sont fournies par systemd via EnvironmentFile.

# Requis : token du bot Discord (Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Chemin du fichier SQLite. Le dossier parent est créé au besoin.
# Défaut en production : /var/lib/animestats/animestats.db
DB_PATH=./data/animestats.db

# Fuseau utilisé pour les tâches planifiées et le découpage par jour.
TZ=Europe/Paris

# Minutes retirées par épisode pour compenser l'opening et l'ending.
OP_ED_MINUTES=3

# Garde-fou de pagination AniList (pages de 100 activités).
ANILIST_MAX_PAGES=20

# Durée de vie du cache mémoire des activités (ex: 5m). 0 = désactivé.
ANILIST_CACHE_TTL=0

# debug | info | warn | error
LOG_LEVEL=info

# Envoyer un récap immédiatement après un /follow réussi.
SEND_RECAP_ON_FOLLOW=true

# Expressions cron (5 champs), évaluées dans le fuseau TZ.
MONTHLY_CRON=0 10 1 * *
YEARLY_CRON=0 12 1 1 *

# Optionnel : enregistre les commandes sur une seule guilde (propagation immédiate)
# au lieu du global (jusqu'à 1 h). Pratique en développement.
DEV_GUILD_ID=

# Rattraper au démarrage un envoi planifié manqué (machine éteinte à l'heure
# prévue). Sans effet au tout premier démarrage, qui ne rattrape jamais rien.
CATCHUP_MISSED_RUNS=true
